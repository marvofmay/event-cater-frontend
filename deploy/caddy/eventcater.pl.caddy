# Wstawić POWYŻEJ bloku catch-all ":443" w aestio Caddyfile.
# Wymaga: kontenery eventcater-frontend i eventcater-mercure w tej samej
# sieci Dockera co caddy_symfony (zrób: bash deploy/scripts/fix-caddy-eventcater.sh).

http://eventcater.pl, http://www.eventcater.pl {
	redir https://{host}{uri} permanent
}

eventcater.pl, www.eventcater.pl {
	encode gzip zstd

	handle /.well-known/mercure* {
		reverse_proxy eventcater-mercure:80 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy eventcater-frontend:3000
	}
}
