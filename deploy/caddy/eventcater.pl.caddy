# Dopisz do /home/marcin/apps/aestio/docker/caddy/Caddyfile (kontener caddy_symfony).
# Bez osobnego bloku http://… — Caddy sam robi HTTP→HTTPS i ACME HTTP-01.
# Jeśli www.eventcater.pl nie ma jeszcze rekordu A, zostaw tylko eventcater.pl.

eventcater.pl, www.eventcater.pl {
	encode gzip zstd

	handle /.well-known/mercure* {
		reverse_proxy 172.17.0.1:3011 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 172.17.0.1:3010
	}
}
