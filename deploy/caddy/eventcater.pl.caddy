# EventCater — managed cert (HTTP-01), NIE on-demand / catch-all :443.
# Na start tylko apex; www dodaj po rekordzie A w DNS.

eventcater.pl {
	encode gzip zstd

	handle /.well-known/mercure* {
		reverse_proxy 172.17.0.1:3011 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 172.17.0.1:3010
	}
}
