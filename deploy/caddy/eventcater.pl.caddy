# EventCater — managed cert (HTTP-01). Wstawić POWYŻEJ bloku catch-all ":443".
# Nie używać on_demand (ask aestio odrzuci tę domenę).

http://eventcater.pl, http://www.eventcater.pl {
	redir https://{host}{uri} permanent
}

eventcater.pl, www.eventcater.pl {
	encode gzip zstd

	handle /.well-known/mercure* {
		reverse_proxy 172.17.0.1:3011 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 172.17.0.1:3010
	}
}
