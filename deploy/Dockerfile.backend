FROM php:8.4-apache

RUN apt-get update && apt-get upgrade -y && apt-get install -y \
      git unzip libicu-dev zlib1g-dev libxml2-dev libzip-dev \
      librabbitmq-dev libpng-dev libjpeg-dev libfreetype6-dev \
    && pecl install amqp redis \
    && docker-php-ext-configure pdo_mysql --with-pdo-mysql=mysqlnd \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_mysql sockets intl opcache zip gd \
    && docker-php-ext-enable amqp redis \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

COPY config/php/event-media.ini /usr/local/etc/php/conf.d/event-media.ini
COPY apache-config.conf /etc/apache2/sites-available/000-default.conf
RUN a2enmod rewrite headers \
    && printf 'opcache.enable=1\nopcache.memory_consumption=128\nopcache.validate_timestamps=0\n' \
      > /usr/local/etc/php/conf.d/opcache-prod.ini

WORKDIR /var/www/html
COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader
COPY . .
RUN composer dump-autoload --optimize --classmap-authoritative \
    && mkdir -p var/cache var/log public/upload/avatars storage/upload/import \
    && chown -R www-data:www-data var public/upload storage \
    && chmod -R 2775 public/upload storage var

EXPOSE 80
CMD ["apache2-foreground"]
