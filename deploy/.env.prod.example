# Skopiuj do /home/marcin/apps/eventcater/.env i uzupełnij przed pierwszym uruchomieniem.
# Nie commituj pliku .env z prawdziwymi sekretami.

COMPOSE_PROJECT_NAME=eventcater
DOMAIN=eventcater.pl
APP_URL=https://eventcater.pl
PASSWORD_RESET_URL=https://eventcater.pl/reset-password
PASSWORD_RESET_SENDER=noreply@eventcater.pl

# Wygeneruj: openssl rand -hex 32
APP_SECRET=CHANGE_ME_APP_SECRET

# MySQL — użyj silnych haseł; nie używaj konta root w DATABASE_URL aplikacji
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=service_company
MYSQL_USER=eventcater
MYSQL_PASSWORD=CHANGE_ME_DB_USER

DATABASE_URL="mysql://eventcater:CHANGE_ME_DB_USER@service-company-db:3306/service_company?serverVersion=9.3.0&charset=utf8mb4"

# JWT — passphrase musi zgadzać się z kluczami w backend/config/jwt/
JWT_SECRET_KEY="%kernel.project_dir%/config/jwt/private.pem"
JWT_PUBLIC_KEY="%kernel.project_dir%/config/jwt/public.pem"
JWT_PASSPHRASE=CHANGE_ME_JWT_PASSPHRASE

# RabbitMQ
RABBITMQ_DEFAULT_USER=eventcater
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBIT
MESSENGER_TRANSPORT_DSN="amqp://eventcater:CHANGE_ME_RABBIT@rabbitmq:5672/%2f"

# Redis
REDIS_URL=redis://redis:6379

# Mercure — ten sam sekret w backendzie i w hubie; wygeneruj: openssl rand -hex 32
MERCURE_JWT_SECRET=CHANGE_ME_MERCURE
MERCURE_URL=http://mercure:80/.well-known/mercure
MERCURE_PUBLIC_URL=https://eventcater.pl/.well-known/mercure
NEXT_PUBLIC_MERCURE_URL=https://eventcater.pl/.well-known/mercure

# Poczta produkcyjna (przykład home.pl / SMTP zewnętrzny)
# MAILER_DSN=smtp://USER:PASSWORD@smtp.home.pl:587
MAILER_DSN=smtp://127.0.0.1:25

APP_ENV=prod
APP_TIMEZONE=Europe/Warsaw
CORS_ALLOW_ORIGIN='^https://(www\.)?eventcater\.pl$'

# Frontend → backend w sieci Dockera
API_INTERNAL_URL=http://service-company:80

# Opcjonalnie: ścieżka lokalnego klona (bootstrap ustawia domyślnie)
# FRONTEND_REF=main
# BACKEND_REF=master
